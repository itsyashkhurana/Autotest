  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test tests/reqres-api.spec.js --project=chromium",
    "test:api:report": "playwright test tests/reqres-api.spec.js --project=chromium && playwright show-report --host 127.0.0.1 --port 9324",
    "test:headed": "playwright test --headed --project=chromium",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "report:alt": "playwright show-report --host 127.0.0.1 --port 9324",
    "test:report": "playwright test && playwright show-report --host 127.0.0.1 --port 9324"
